   "source": [
    "list_of_values = [(1,6,7), (2,4,8),(3,7,16), (6,8,44), (7,1,50), (8,4,68)]\n",
    "distances = []\n",
    "for x1, x2, y1 in list_of_values:\n",
    "    dist = abs(4-x1) + abs(2-x2)\n",
    "    distances.append((dist, y1))\n",
    "distances.sort()\n",
    "distances[:3]\n",
    "val = 0\n",
    "for dist, y1 in (distances[:3]):\n",
    "    val += y1\n",
    "val/3\n"
   ],
