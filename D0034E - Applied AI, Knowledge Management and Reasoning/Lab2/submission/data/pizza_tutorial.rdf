<?xml version="1.0"?>
<rdf:RDF xmlns="http://www.semanticweb.org/velijapovlakic/ontologies/2026/10/Lab2PizzaTutorial/"
     xml:base="http://www.semanticweb.org/velijapovlakic/ontologies/2026/10/Lab2PizzaTutorial/"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:Lab2PizzaTutorial="http://www.semanticweb.org/velijapovlakic/ontologies/2026/10/Lab2PizzaTutorial#">
    <owl:Ontology rdf:about="http://www.semanticweb.org/velijapovlakic/ontologies/2026/10/Lab2PizzaTutorial">
        <rdfs:comment>A tutorial ontology for the Pizza domain</rdfs:comment>
    </owl:Ontology>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.semanticweb.org/velijapovlakic/ontologies/2026/10/Lab2PizzaTutorial#hasBase -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/velijapovlakic/ontologies/2026/10/Lab2PizzaTutorial#hasBase">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/velijapovlakic/ontologies/2026/10/Lab2PizzaTutorial#hasIngredient"/>
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/velijapovlakic/ontologies/2026/10/Lab2PizzaTutorial#isBaseOf"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/velijapovlakic/ontologies/2026/10/Lab2PizzaTutorial#Pizza"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/velijapovlakic/ontologies/2026/10/Lab2PizzaTutorial#PizzaBase"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/velijapovlakic/ontologies/2026/10/Lab2PizzaTutorial#hasIngredient -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/velijapovlakic/ontologies/2026/10/Lab2PizzaTutorial#hasIngredient">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/velijapovlakic/ontologies/2026/10/Lab2PizzaTutorial#isIngredientOf"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/velijapovlakic/ontologies/2026/10/Lab2PizzaTutorial#hasSpiciness -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/velijapovlakic/ontologies/2026/10/Lab2PizzaTutorial#hasSpiciness"/>
    


    <!-- http://www.semanticweb.org/velijapovlakic/ontologies/2026/10/Lab2PizzaTutorial#hasTopping -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/velijapovlakic/ontologies/2026/10/Lab2PizzaTutorial#hasTopping">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/velijapovlakic/ontologies/2026/10/Lab2PizzaTutorial#hasIngredient"/>
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/velijapovlakic/ontologies/2026/10/Lab2PizzaTutorial#isToppingOf"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/velijapovlakic/ontologies/2026/10/Lab2PizzaTutorial#Pizza"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/velijapovlakic/ontologies/2026/10/Lab2PizzaTutorial#PizzaTopping"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/velijapovlakic/ontologies/2026/10/Lab2PizzaTutorial#isBaseOf -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/velijapovlakic/ontologies/2026/10/Lab2PizzaTutorial#isBaseOf">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/velijapovlakic/ontologies/2026/10/Lab2PizzaTutorial#isIngredientOf"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/velijapovlakic/ontologies/2026/10/Lab2PizzaTutorial#isIngredientOf -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/velijapovlakic/ontologies/2026/10/Lab2PizzaTutorial#isIngredientOf"/>
    


    <!-- http://www.semanticweb.org/velijapovlakic/ontologies/2026/10/Lab2PizzaTutorial#isMilderThan -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/velijapovlakic/ontologies/2026/10/Lab2PizzaTutorial#isMilderThan">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/velijapovlakic/ontologies/2026/10/Lab2PizzaTutorial#isSpicierThan"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/velijapovlakic/ontologies/2026/10/Lab2PizzaTutorial#Spiciness"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/velijapovlakic/ontologies/2026/10/Lab2PizzaTutorial#Spiciness"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/velijapovlakic/ontologies/2026/10/Lab2PizzaTutorial#isSpicierThan -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/velijapovlakic/ontologies/2026/10/Lab2PizzaTutorial#isSpicierThan">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/velijapovlakic/ontologies/2026/10/Lab2PizzaTutorial#Spiciness"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/velijapovlakic/ontologies/2026/10/Lab2PizzaTutorial#Spiciness"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/velijapovlakic/ontologies/2026/10/Lab2PizzaTutorial#isToppingOf -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/velijapovlakic/ontologies/2026/10/Lab2PizzaTutorial#isToppingOf">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/velijapovlakic/ontologies/2026/10/Lab2PizzaTutorial#isIngredientOf"/>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.semanticweb.org/velijapovlakic/ontologies/2026/10/Lab2PizzaTutorial#hasCaloricContent -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/velijapovlakic/ontologies/2026/10/Lab2PizzaTutorial#hasCaloricContent">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/velijapovlakic/ontologies/2026/10/Lab2PizzaTutorial#Pizza"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    </owl:DatatypeProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.semanticweb.org/velijapovlakic/ontologies/2026/10/Lab2PizzaTutorial#AmericanaHotPizza -->

    <owl:Class rdf:about="http://www.semanticweb.org/velijapovlakic/ontologies/2026/10/Lab2PizzaTutorial#AmericanaHotPizza">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/velijapovlakic/ontologies/2026/10/Lab2PizzaTutorial#NamedPizza"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/velijapovlakic/ontologies/2026/10/Lab2PizzaTutorial#hasTopping"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/velijapovlakic/ontologies/2026/10/Lab2PizzaTutorial#JalapenoPepperTopping"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/velijapovlakic/ontologies/2026/10/Lab2PizzaTutorial#hasTopping"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/velijapovlakic/ontologies/2026/10/Lab2PizzaTutorial#MozzarellaTopping"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/velijapovlakic/ontologies/2026/10/Lab2PizzaTutorial#hasTopping"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/velijapovlakic/ontologies/2026/10/Lab2PizzaTutorial#PepperoniTopping"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/velijapovlakic/ontologies/2026/10/Lab2PizzaTutorial#hasTopping"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/velijapovlakic/ontologies/2026/10/Lab2PizzaTutorial#TomatoTopping"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>A pizza that only has Mozzarella, Tomato toppings, Pepperoni toppings and Jalapeno pepperoni toppings</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/velijapovlakic/ontologies/2026/10/Lab2PizzaTutorial#AmericanaPizza -->

    <owl:Class rdf:about="http://www.semanticweb.org/velijapovlakic/ontologies/2026/10/Lab2PizzaTutorial#AmericanaPizza">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/velijapovlakic/ontologies/2026/10/Lab2PizzaTutorial#NamedPizza"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/velijapovlakic/ontologies/2026/10/Lab2PizzaTutorial#hasTopping"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/velijapovlakic/ontologies/2026/10/Lab2PizzaTutorial#MozzarellaTopping"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/velijapovlakic/ontologies/2026/10/Lab2PizzaTutorial#hasTopping"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/velijapovlakic/ontologies/2026/10/Lab2PizzaTutorial#PepperoniTopping"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/velijapovlakic/ontologies/2026/10/Lab2PizzaTutorial#hasTopping"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/velijapovlakic/ontologies/2026/10/Lab2PizzaTutorial#TomatoTopping"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>A pizza that only has Mozzarella, Tomato toppings and Pepperoni toppings</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/velijapovlakic/ontologies/2026/10/Lab2PizzaTutorial#AnchovyTopping -->

    <owl:Class rdf:about="http://www.semanticweb.org/velijapovlakic/ontologies/2026/10/Lab2PizzaTutorial#AnchovyTopping">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/velijapovlakic/ontologies/2026/10/Lab2PizzaTutorial#SeafoodTopping"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/velijapovlakic/ontologies/2026/10/Lab2PizzaTutorial#BasilTopping -->

    <owl:Class rdf:about="http://www.semanticweb.org/velijapovlakic/ontologies/2026/10/Lab2PizzaTutorial#BasilTopping">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/velijapovlakic/ontologies/2026/10/Lab2PizzaTutorial#VegetableTopping"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/velijapovlakic/ontologies/2026/10/Lab2PizzaTutorial#CaperTopping -->

    <owl:Class rdf:about="http://www.semanticweb.org/velijapovlakic/ontologies/2026/10/Lab2PizzaTutorial#CaperTopping">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/velijapovlakic/ontologies/2026/10/Lab2PizzaTutorial#VegetableTopping"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/velijapovlakic/ontologies/2026/10/Lab2PizzaTutorial#CheeseTopping -->

    <owl:Class rdf:about="http://www.semanticweb.org/velijapovlakic/ontologies/2026/10/Lab2PizzaTutorial#CheeseTopping">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/velijapovlakic/ontologies/2026/10/Lab2PizzaTutorial#PizzaTopping"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/velijapovlakic/ontologies/2026/10/Lab2PizzaTutorial#CheesyPizza -->

    <owl:Class rdf:about="http://www.semanticweb.org/velijapovlakic/ontologies/2026/10/Lab2PizzaTutorial#CheesyPizza">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/velijapovlakic/ontologies/2026/10/Lab2PizzaTutorial#Pizza"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/velijapovlakic/ontologies/2026/10/Lab2PizzaTutorial#hasTopping"/>
                        <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/velijapovlakic/ontologies/2026/10/Lab2PizzaTutorial#CheeseTopping"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/velijapovlakic/ontologies/2026/10/Lab2PizzaTutorial#CreamCheeseTopping -->

    <owl:Class rdf:about="http://www.semanticweb.org/velijapovlakic/ontologies/2026/10/Lab2PizzaTutorial#CreamCheeseTopping">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/velijapovlakic/ontologies/2026/10/Lab2PizzaTutorial#CheeseTopping"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/velijapovlakic/ontologies/2026/10/Lab2PizzaTutorial#DeepPanBase -->

    <owl:Class rdf:about="http://www.semanticweb.org/velijapovlakic/ontologies/2026/10/Lab2PizzaTutorial#DeepPanBase">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/velijapovlakic/ontologies/2026/10/Lab2PizzaTutorial#PizzaBase"/>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/velijapovlakic/ontologies/2026/10/Lab2PizzaTutorial#ThinAndCrispyBase"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/velijapovlakic/ontologies/2026/10/Lab2PizzaTutorial#GarlicTopping -->

    <owl:Class rdf:about="http://www.semanticweb.org/velijapovlakic/ontologies/2026/10/Lab2PizzaTutorial#GarlicTopping">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/velijapovlakic/ontologies/2026/10/Lab2PizzaTutorial#VegetableTopping"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/velijapovlakic/ontologies/2026/10/Lab2PizzaTutorial#GreenPepperTopping -->

    <owl:Class rdf:about="http://www.semanticweb.org/velijapovlakic/ontologies/2026/10/Lab2PizzaTutorial#GreenPepperTopping">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/velijapovlakic/ontologies/2026/10/Lab2PizzaTutorial#PepperTopping"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/velijapovlakic/ontologies/2026/10/Lab2PizzaTutorial#HamTopping -->

    <owl:Class rdf:about="http://www.semanticweb.org/velijapovlakic/ontologies/2026/10/Lab2PizzaTutorial#HamTopping">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/velijapovlakic/ontologies/2026/10/Lab2PizzaTutorial#MeatTopping"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/velijapovlakic/ontologies/2026/10/Lab2PizzaTutorial#HighCaloriePizza -->

    <owl:Class rdf:about="http://www.semanticweb.org/velijapovlakic/ontologies/2026/10/Lab2PizzaTutorial#HighCaloriePizza">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/velijapovlakic/ontologies/2026/10/Lab2PizzaTutorial#Pizza"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/velijapovlakic/ontologies/2026/10/Lab2PizzaTutorial#hasCaloricContent"/>
                        <owl:someValuesFrom>
                            <rdfs:Datatype>
                                <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
                                <owl:withRestrictions rdf:parseType="Collection">
                                    <rdf:Description>
                                        <xsd:minInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">400</xsd:minInclusive>
                                    </rdf:Description>
                                </owl:withRestrictions>
                            </rdfs:Datatype>
                        </owl:someValuesFrom>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/velijapovlakic/ontologies/2026/10/Lab2PizzaTutorial#InterestingPizza -->

    <owl:Class rdf:about="http://www.semanticweb.org/velijapovlakic/ontologies/2026/10/Lab2PizzaTutorial#InterestingPizza">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/velijapovlakic/ontologies/2026/10/Lab2PizzaTutorial#Pizza"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/velijapovlakic/ontologies/2026/10/Lab2PizzaTutorial#hasTopping"/>
                        <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">3</owl:minQualifiedCardinality>
                        <owl:onClass rdf:resource="http://www.semanticweb.org/velijapovlakic/ontologies/2026/10/Lab2PizzaTutorial#PizzaTopping"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/velijapovlakic/ontologies/2026/10/Lab2PizzaTutorial#JalapenoPepperTopping -->

    <owl:Class rdf:about="http://www.semanticweb.org/velijapovlakic/ontologies/2026/10/Lab2PizzaTutorial#JalapenoPepperTopping">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/velijapovlakic/ontologies/2026/10/Lab2PizzaTutorial#PepperTopping"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/velijapovlakic/ontologies/2026/10/Lab2PizzaTutorial#hasSpiciness"/>
                <owl:hasValue rdf:resource="http://www.semanticweb.org/velijapovlakic/ontologies/2026/10/Lab2PizzaTutorial#Hot"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/velijapovlakic/ontologies/2026/10/Lab2PizzaTutorial#KebabMeatTopping -->

    <owl:Class rdf:about="http://www.semanticweb.org/velijapovlakic/ontologies/2026/10/Lab2PizzaTutorial#KebabMeatTopping">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/velijapovlakic/ontologies/2026/10/Lab2PizzaTutorial#MeatTopping"/>
        <rdfs:comment>Beef</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/velijapovlakic/ontologies/2026/10/Lab2PizzaTutorial#KebabPizza -->

    <owl:Class rdf:about="http://www.semanticweb.org/velijapovlakic/ontologies/2026/10/Lab2PizzaTutorial#KebabPizza">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/velijapovlakic/ontologies/2026/10/Lab2PizzaTutorial#NamedPizza"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/velijapovlakic/ontologies/2026/10/Lab2PizzaTutorial#hasTopping"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/velijapovlakic/ontologies/2026/10/Lab2PizzaTutorial#BasilTopping"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/velijapovlakic/ontologies/2026/10/Lab2PizzaTutorial#hasTopping"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/velijapovlakic/ontologies/2026/10/Lab2PizzaTutorial#CreamCheeseTopping"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/velijapovlakic/ontologies/2026/10/Lab2PizzaTutorial#hasTopping"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/velijapovlakic/ontologies/2026/10/Lab2PizzaTutorial#JalapenoPepperTopping"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/velijapovlakic/ontologies/2026/10/Lab2PizzaTutorial#hasTopping"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/velijapovlakic/ontologies/2026/10/Lab2PizzaTutorial#KebabMeatTopping"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/velijapovlakic/ontologies/2026/10/Lab2PizzaTutorial#hasTopping"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/velijapovlakic/ontologies/2026/10/Lab2PizzaTutorial#KebabSauceTopping"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/velijapovlakic/ontologies/2026/10/Lab2PizzaTutorial#hasTopping"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/velijapovlakic/ontologies/2026/10/Lab2PizzaTutorial#MozzarellaTopping"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/velijapovlakic/ontologies/2026/10/Lab2PizzaTutorial#hasTopping"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/velijapovlakic/ontologies/2026/10/Lab2PizzaTutorial#OreganoTopping"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/velijapovlakic/ontologies/2026/10/Lab2PizzaTutorial#hasTopping"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/velijapovlakic/ontologies/2026/10/Lab2PizzaTutorial#RedOnionTopping"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/velijapovlakic/ontologies/2026/10/Lab2PizzaTutorial#hasTopping"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/velijapovlakic/ontologies/2026/10/Lab2PizzaTutorial#TomatoTopping"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>Napolitan kebab pizza from the place slice pizza (Velijas favourite), has some tomato topping, mozzarella, cream cheese, oregano, red onions, jalapeno, kebab meat (beef), kebab sauce (medium spicieness.</rdfs:comment>
    </owl:Class>
    


